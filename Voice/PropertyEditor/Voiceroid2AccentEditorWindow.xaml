<Window x:Class="Voiceroid2Ymm.Voice.PropertyEditor.Voiceroid2AccentEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Voiceroid2Ymm.Voice.PropertyEditor"
        mc:Ignorable="d"
        Title="VOICEROID2 発音編集 (アクセント)"
        Width="960"
        Height="420"
        MinWidth="640"
        MinHeight="320"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#EEF0F3">
    <Window.Resources>
        <!-- ============ 単語カード ============ -->
        <Style x:Key="WordCardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E3E6EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPunctuationWord}" Value="True">
                    <Setter Property="Background" Value="#EEF1F5"/>
                    <Setter Property="BorderBrush" Value="#E0E4EA"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ カードヘッダー帯 ============ -->
        <Style x:Key="CardHeaderBandStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#E4E9F0"/>
            <Setter Property="BorderBrush" Value="#D7DEE8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="7,7,0,0"/>
            <Setter Property="Height" Value="30"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPunctuationWord}" Value="True">
                    <Setter Property="Background" Value="#DCE2EA"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderTextBlockStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

        <Style x:Key="MoraTextBlockStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#8A8F99"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- 句読点カードで本文を隠すためのスタイル -->
        <Style x:Key="PunctuationCollapseStyle" TargetType="{x:Type FrameworkElement}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPunctuationWord}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 読み編集中にモーラ行を隠すためのスタイル -->
        <Style x:Key="EditingReadingCollapseStyle" TargetType="{x:Type FrameworkElement}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditingReading}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ヘッダー帯下の読み編集欄 (編集中のみ表示) -->
        <Style x:Key="ReadingEditTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#7197CC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="6,6,6,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#3A3D44"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditingReading}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ ツールバーのボタン ============ -->
        <Style x:Key="ToolBarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="#565A62"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="B"
                                Background="#FFFFFF"
                                BorderBrush="#DDE1E7"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#F2F6FB"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#BCD0E8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ToolBarButtonStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="B"
                                Background="#565860"
                                BorderBrush="#565860"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#6A6D77"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#6A6D77"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Border Background="#F2F3F5" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ 上部ツールバー ============ -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ToolBarButtonStyle}"
                            Content="プレビュー再生"
                            Command="{Binding PlayCommand}"/>
                    <Button Style="{StaticResource ToolBarButtonStyle}"
                            Content="既定に戻す"
                            Command="{Binding ResetCommand}"/>
                </StackPanel>
                <TextBlock Text="アクセント編集 (モーラをクリック/ドラッグ: アクセント位置変更 / 単語の読みをクリック: よみがな編集)"
                           FontWeight="SemiBold"
                           Foreground="#565A62"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- ============ 単語カード ============ -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Words}" Margin="2,6,2,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource WordCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Style="{StaticResource CardHeaderBandStyle}"
                                            Cursor="Hand"
                                            ToolTip="クリックで読みを編集"
                                            MouseLeftButtonDown="HeaderBand_MouseLeftButtonDown">
                                        <TextBlock Text="{Binding Surface}" Style="{StaticResource HeaderTextBlockStyle}"/>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="6,8,6,10"
                                                Style="{StaticResource PunctuationCollapseStyle}">
                                        <TextBox Style="{StaticResource ReadingEditTextBoxStyle}"
                                                 Text="{Binding ReadingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsVisibleChanged="ReadingTextBox_IsVisibleChanged"
                                                 LostFocus="ReadingTextBox_LostFocus"
                                                 KeyDown="ReadingTextBox_KeyDown"/>
                                        <ItemsControl ItemsSource="{Binding Moras}"
                                                      Style="{StaticResource EditingReadingCollapseStyle}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Kana}" Width="46"
                                                               Style="{StaticResource MoraTextBlockStyle}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <local:AccentLineControl ItemsSource="{Binding Moras}"
                                                                 ColumnWidth="46"
                                                                 Height="110"
                                                                 Margin="0,8,0,2"
                                                                 LineBrush="#86A9D6"
                                                                 EditableDotBrush="#7197CC"
                                                                 SpecialDotBrush="#C2C7CE"
                                                                 FillBrush="#EEF3FA"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ============ 下部ボタン ============ -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Content="OK (適用)"
                        MinWidth="96"
                        Click="OkButton_Click"/>
                <Button Style="{StaticResource ToolBarButtonStyle}"
                        Content="キャンセル"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
